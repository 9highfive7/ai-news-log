{
  "name": "ai-news-log",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit -p tsconfig.scripts.json",
    "generate": "tsx scripts/generate.ts",
    "generate:dry": "tsx scripts/generate.ts --dry-run",
    "check-feeds": "tsx scripts/check-feeds.ts",
    "compare": "tsx scripts/generate.ts --provider=compare"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@google/genai": "^2.26.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "astro": "^7.3.5",
    "openai": "^7.27.0",
    "rss-parser": "^3.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.3",
    "pagefind": "^1.5.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
