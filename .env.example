# ローカル実行用。.env にコピーして値を入れてください（.env はコミットされません）

# 使うモデルの種類: claude / gemini / openai / compare（比較モード）。省略時は claude
LLM_PROVIDER=

# Claude を使う場合
ANTHROPIC_API_KEY=
# 省略時は claude-haiku-4-5
ANTHROPIC_MODEL=

# Gemini を使う場合（Google AI Studio で発行）
GEMINI_API_KEY=
# 省略時は gemini-3.5-flash-lite
GEMINI_MODEL=

# GPT を使う場合
OPENAI_API_KEY=
# 省略時は gpt-6-luna
OPENAI_MODEL=
# 推論の深さ（none / low / medium など）。省略時は low
OPENAI_REASONING_EFFORT=

# 比較モードの審査役 Jev（TypeSafe AI）。未設定なら審査なしで比較する
TYPESAFE_API_KEY=
# 省略時は jev-latest
TYPESAFE_DEFAULT_MODEL=

# 1回に生成する最大本数（省略時 5）
MAX_ARTICLES=
