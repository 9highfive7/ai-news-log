---
import { tagSlug } from '../consts';
import { listPoints, listSummary, listTitle, postUrl, url, type Post } from '../lib';

interface Props {
  post: Post;
  hero?: boolean;
}

const { post, hero = false } = Astro.props;
const points = hero ? listPoints(post) : [];
---

<article class:list={['card', { 'card--hero': hero }]}>
  {
    hero && (
      <p class="card__eyebrow">
        <span>要チェック</span>
        {/* 赤ペンで手描きした丸（少しゆがんだ楕円） */}
        <svg class="card__circle" viewBox="0 0 120 44" preserveAspectRatio="none" aria-hidden="true">
          <path d="M14 9C35 1 92 0 111 12c13 9 2 24-25 28-27 4-66 3-80-7C-4 26 3 14 22 8c10-3 22-4 34-4" />
        </svg>
      </p>
    )
  }
  <h3 class="card__title">
    <a href={postUrl(post)}>{listTitle(post)}</a>
  </h3>
  <p class="card__excerpt">{listSummary(post)}</p>
  <div class="card__meta">
    <span class="card__source">出典：{post.data.source_name}</span>
    <span class="card__tags">
      {
        post.data.tags.map((tag) => (
          <a class={`tag tag--${tagSlug(tag)}`} href={url(`tags/${tagSlug(tag)}/`)}>
            {tag}
          </a>
        ))
      }
    </span>
  </div>
  {
    points.length > 0 && (
      <details class="card__points" open>
        <summary class="card__points-title">ポイント</summary>
        <ul>
          {points.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </details>
    )
  }
</article>
{/* スマホでは「ポイント」の付箋を閉じた状態で表示する（PCでは開いたまま） */}
{
  points.length > 0 && (
    <script
      is:inline
      set:html={"if (matchMedia('(max-width: 767px)').matches) document.querySelectorAll('.card__points').forEach((d) => d.removeAttribute('open'));"}
    />
  )
}
