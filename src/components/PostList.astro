---
import { tagSlug } from '../consts';
import { groupByDate, postUrl, url, type Post } from '../lib';

interface Props {
  posts: Post[];
}

const groups = groupByDate(Astro.props.posts);
---

{
  groups.map((group) => (
    <section>
      <h2 class="date-heading">
        <time datetime={group.key}>{group.heading}</time>
      </h2>
      <ul class="post-list">
        {group.posts.map((post) => (
          <li class="post-card">
            <h3>
              <a href={postUrl(post)}>{post.data.title}</a>
            </h3>
            <div class="meta">
              <span>{post.data.source_name}</span>
              {post.data.tags.map((tag) => (
                <a class="tag" href={url(`tags/${tagSlug(tag)}/`)}>
                  {tag}
                </a>
              ))}
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))
}
