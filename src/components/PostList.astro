---
import PostCard from './PostCard.astro';
import { groupByDate, type Post } from '../lib';

interface Props {
  posts: Post[];
  /** 先頭の記事を「最新ニュース」として大きく表示する（トップページの1ページ目のみ） */
  withHero?: boolean;
}

const { posts, withHero = false } = Astro.props;
const groups = groupByDate(posts);
const heroId = withHero ? posts[0]?.id : undefined;
---

{
  groups.map((group) => (
    <section class="day" aria-labelledby={`day-${group.key}`}>
      <h2 class="day__heading" id={`day-${group.key}`}>
        <span class="day__label"><time datetime={group.key}>{group.label}</time>の切り抜き</span>
        {/* 件数は「最新ニュース」も含めた、その日の記事数 */}
        <span class="day__count">{group.posts.length}件</span>
      </h2>
      {group.posts.some((p) => p.id === heroId) && <PostCard post={group.posts.find((p) => p.id === heroId)!} hero />}
      <div class="cards">
        {group.posts
          .filter((p) => p.id !== heroId)
          .map((post) => (
            <PostCard post={post} />
          ))}
      </div>
    </section>
  ))
}
